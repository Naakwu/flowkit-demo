{
  "name": "@flowkit-demo/workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun run apps/api/src/main.ts",
    "dev:worker": "bun run apps/worker/src/main.ts",
    "dev:notify": "bun run apps/notify-worker/src/delivery.worker.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "db:migrate": "bun run packages/database/scripts/migrate.ts",
    "db:seed": "bun run packages/database/scripts/seed.ts",
    "scenario": "bun run apps/api/scripts/run-scenario.ts",
    "test": "bun test ./test/",
    "test:integration": "bun test test/*.integration.test.ts",
    "test:browser": "playwright test -c playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && bun run build:web",
    "build:web": "bun run --cwd apps/web build",
    "stack:up": "docker compose -p flowkit_demo -f docker-compose.yml up -d --wait",
    "stack:ci": "bun run scripts/stack-ci.ts",
    "stack:down": "docker compose -p flowkit_demo -f docker-compose.yml down",
    "stack:reset": "bun run scripts/reset-stack.ts"
  },
  "dependencies": {
    "@flowkit-demo/database": "workspace:*",
    "@flowkit-demo/domain": "workspace:*",
    "@naakwu/flowkit-auth": "0.2.0",
    "@naakwu/flowkit-consumer": "0.2.0",
    "@naakwu/flowkit-core": "0.2.0",
    "@naakwu/flowkit-notify": "0.2.0",
    "@naakwu/flowkit-tasks": "0.2.0",
    "@naakwu/flowkit-temporal": "0.2.0",
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "@nestjs/platform-express": "11.1.9",
    "@temporalio/client": "1.16.2",
    "@temporalio/worker": "1.16.2",
    "@temporalio/workflow": "1.16.2",
    "better-auth": "1.3.34",
    "drizzle-orm": "^0.44.4",
    "express": "5.1.0",
    "nodemailer": "^7.0.3",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@temporalio/testing": "1.16.2",
    "@types/express": "4.17.22",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "better-call": "1.0.19",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5"
  }
}
